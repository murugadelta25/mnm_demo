# Python
backend/venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/routers/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Node
node_modules/
frontend/node_modules/
frontend/dist/
# Accidental root npm install (EAP PMS deps live under frontend/)
/package.json
/package-lock.json

# Logs
*.log
backend.log
frontend.log
deploy/nginx-win/logs/

# PID files
.backend.pid
.frontend.pid

# Env / secrets (keep .env.example)
backend/.env
frontend/.env
database/db.config.json
deploy.env

# OS / IDE
.DS_Store
Thumbs.db
.cursor/
.vscode/
.claude/
.codex/

# Build / package artifacts
*.zip
eap-pms.zip
*.xlsx

# Database backups
database/backups/

# Dev-only bundles (not for deployment)
bug_fixing_patch1/
TITAN_OEE_FULL_PACKAGE/
new_theme/
demo/
frontend/src/pages/gemini_*
frontend/src/pages/old_*
frontend/src/pages/bug_*

# Bundled nginx binary (use scripts/install-nginx.sh on server)
deploy/nginx-win/

# Auto-generated TLS material (created by run.sh / run.ps1)
deploy/ssl/*.crt
deploy/ssl/*.key
deploy/ssl/*.pem
!deploy/ssl/.gitkeep

# Uploaded work-instruction PDFs / images (runtime uploads via parts API)
backend/static/work-instructions/*
!backend/static/work-instructions/.gitkeep

# Part images / sketches uploaded via API
backend/static/parts/*
!backend/static/parts/.gitkeep

# Machine images uploaded via API
backend/static/machines/*
!backend/static/machines/.gitkeep

# Operator / user face-verification reference photos (runtime uploads via API)
backend/static/operator-reference/*
!backend/static/operator-reference/.gitkeep

# Factory logos uploaded via API (runtime uploads via /api/config/factory-logo)
backend/static/factory/*
!backend/static/factory/.gitkeep

# Operator session photos uploaded via mobile API
backend/static/operator-sessions/*
!backend/static/operator-sessions/.gitkeep

# Local one-off translation scratch (personal paths / caches — not product code)
_translate_manual.py
_trans_cache.json
_tmp_manual_extract.txt

# Runtime PMS telemetry backups
backend/backups/
