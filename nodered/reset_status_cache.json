    {
        "id": "f0da547011aa7075",
        "type": "function",
        "z": "21c7b4b9c79b746a",
        "name": "LO Logic → machine 1 (CN40)",
        "func": "let statusObj = msg.payload.find(item => {\n    let n = item.name || item.displayName?.text || item.displayName || \"\";\n    return typeof n === \"string\" && n.toLowerCase() === \"statuscode\";\n});\nif (!statusObj) return null;\n\nlet raw = statusObj.value?.value ?? statusObj.value;\n\nlet currentStatus;\nif (raw === \"\" || raw === null || raw === undefined) {\n    currentStatus = \"offline\";\n} else {\n    let statusMap = { 1: \"running\", 2: \"idle\", 3: \"alarm\", 4: \"offline\" };\n    currentStatus = statusMap[Number(raw)] || \"offline\";\n}\n\nlet prev     = flow.get(\"LO_previousStatus\");\nlet lastSent = flow.get(\"LO_lastSentTime\") || 0;\nlet now      = Date.now();\n\n// Push if: status changed  OR  30 s heartbeat (corrects any backend internal override)\nif (currentStatus === prev && (now - lastSent) < 30000) return null;\n\nflow.set(\"LO_previousStatus\", currentStatus);\nflow.set(\"LO_lastSentTime\",   now);\n\nmsg.method  = \"PATCH\";\nmsg.url     = \"http://192.168.2.202:8010/api/machines/1/status\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = { status: currentStatus, source: \"nodered\" };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
