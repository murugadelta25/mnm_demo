# Copy this file to .env and fill in your values

# --- Database ---
# Windows local MySQL:
# DATABASE_URL=mysql+pymysql://root:YourPassword@localhost:3306/eap_pms
#
# Ubuntu server MySQL:
# DATABASE_URL=mysql+pymysql://titan_user:YourPassword@localhost:3306/eap_pms

DATABASE_URL=mysql+pymysql://root:YourPassword@localhost:3306/eap_pms

# --- Historical archive DB (optional, LAN MySQL on another PC/server) ---
# When set, overrides Database Management → History Archive host fields.
# Old rows (> retention_days, default 60 / ~2 months) are moved here automatically.
# ARCHIVE_DATABASE_URL=mysql+pymysql://archive_user:YourPassword@192.168.0.50:3306/eap_pms_archive

# --- JWT ---
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Platform super-admin (separate URL /platform — NOT customer users) ---
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=ChangeMe-Platform-2026!
PLATFORM_TOKEN_EXPIRE_HOURS=8

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=your@email.com
