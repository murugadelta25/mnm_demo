# Copy to deploy.env and edit before first ./run.sh on Ubuntu
# Or leave blank — run.sh will prompt on first launch

CLIENT_NAME=client_x
DB_USER=root
DB_PASS=YourMySqlPassword
DB_NAME=eap_pms_client_x

BACKEND_PORT=8010
FRONTEND_PORT=5174

# Install and enable systemd services (yes/no)
INSTALL_SYSTEMD=yes

# systemd unit names are derived from CLIENT_NAME, e.g.:
#   client_x-backend.service
#   client_x-frontend.service
